# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
# Local:    postgresql://postgres:postgres@localhost:5432/svp
# Supabase: DATABASE_URL = the "Transaction pooler" string (port 6543) + "?pgbouncer=true&connection_limit=1"
#           DIRECT_URL   = the "Session pooler"/direct string (port 5432), used for migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/svp"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/svp"

# Public URL of the app (used in emails and origin checks)
APP_URL="http://localhost:3000"

# ─── File storage for verification & data-room documents ───────────────────
# "local"    → files under ./.data/uploads (development only; refused in production)
# "supabase" → private Supabase Storage bucket (free tier); requires the 3 variables below
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="sequel-private"

# ─── Email (verification + password reset) ─────────────────────────────────
# "console" → emails are printed to the server log (development / private demo)
# "resend"  → sends through Resend (free tier); requires RESEND_API_KEY and EMAIL_FROM
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="Sequel <no-reply@example.com>"

# Show the demo-account panel on the sign-in page (never enable with real users)
DEMO_MODE="true"
